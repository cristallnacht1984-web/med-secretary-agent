# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_USER_IDS=[111, 222]
TELEGRAM_ADMIN_ID=123456789
TELEGRAM_DIGEST_CHAT_ID=-1001234567890

# LLM Settings (Qwen 3.6 local)
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=dummy
LLM_MODEL_NAME=qwen3.6
LLM_TEMPERATURE_ANALYSIS=0.3
LLM_TEMPERATURE_CLASSIFICATION=0.5
LLM_TEMPERATURE_REMINDER=0.5
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_ANALYSIS=120
LLM_TIMEOUT_CLASSIFICATION=30
LLM_TIMEOUT_REMINDER=30
LLM_RATE_LIMIT_RPM=60
LLM_RATE_LIMIT_TPM=100000
LLM_MAX_RETRIES=3

# Database Settings
DATABASE_URL=sqlite+aiosqlite:///./mednews.db

# Google Calendar Settings (canonical - file-based)
GOOGLE_CREDENTIALS_FILE=secrets/google_credentials.json
GOOGLE_TOKEN_FILE=data/google_token.json
GOOGLE_CALENDAR_ID=primary
# Legacy field (deprecated - use GOOGLE_CREDENTIALS_FILE instead)
GOOGLE_CREDENTIALS_JSON=

# Scheduler Settings (canonical - TZ §6)
DIGEST_HOUR=6
DIGEST_MINUTE=0
REMINDER_POLL_INTERVAL_MINUTES=30
REMINDER_LOOKAHEAD_MINUTES=120
# Legacy fields (deprecated - use canonical above)
DIGEST_TIME_HOUR=6
REMINDER_WINDOW_HOURS=2

# Health Check Settings
HEALTH_CHECK_HOST=0.0.0.0
HEALTH_CHECK_PORT=8080

# Timezone (canonical - TZ §6)
TIMEZONE=Europe/Moscow
# Legacy field (deprecated - use TIMEZONE instead)
USER_TIMEZONE=UTC

# Logging Settings (TZ §6)
LOG_LEVEL=INFO
# LOG_FILE=

# News Pipeline Settings (TZ §2.1)
NEWS_LOOKBACK_HOURS=24
NEWS_DEDUP_WINDOW_DAYS=7
NEWS_BATCH_MIN=3
NEWS_BATCH_MAX=5
NEWS_DELIVERY_RETRIES=3
NEWS_DELIVERY_RETRY_DELAY_MINUTES=5
FETCH_TIMEOUT_SECONDS=30.0
FETCH_MAX_RETRIES=3
