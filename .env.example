# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_USER_IDS=[111, 222]
TELEGRAM_ADMIN_ID=123456789

# LLM Settings (Qwen 3.6 local)
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=dummy
LLM_MODEL_NAME=qwen3.6
LLM_TEMPERATURE_ANALYSIS=0.3
LLM_TEMPERATURE_CLASSIFICATION=0.5
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_ANALYSIS=120
LLM_TIMEOUT_CLASSIFICATION=30
LLM_RATE_LIMIT_RPM=60
LLM_RATE_LIMIT_TPM=100000

# Database Settings
DATABASE_URL=sqlite+aiosqlite:///./mednews.db

# Google Calendar Settings
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CALENDAR_ID=primary

# Scheduler Settings
DIGEST_TIME_HOUR=6
REMINDER_POLL_INTERVAL_MINUTES=30
REMINDER_WINDOW_HOURS=2

# Health Check Settings
HEALTH_CHECK_HOST=0.0.0.0
HEALTH_CHECK_PORT=8080

# Timezone (display only, internal is UTC)
USER_TIMEZONE=UTC
